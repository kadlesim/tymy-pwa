# API base path (proxied to http://dev.tymy.cz in dev)
VITE_API_BASE=/api

# Optional: origin that serves avatars/uploads (e.g. https://tymy.cz)
# Leave empty when assets are served from the same origin as the app.
# VITE_ASSET_ORIGIN=

# Push notifications (VAPID public key from backend)
# VITE_VAPID_PUBLIC_KEY=
